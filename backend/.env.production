# ==============================================================================
# KISAN HIT (KISAN HIT AGRI-COMMERCE) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Server
PORT=5000
NODE_ENV=production
# Update CORS_ORIGIN to your verified production domain(s)
CORS_ORIGIN="https://kisanhit.com,https://admin.kisanhit.com"

# ------------------------------------------------------------------------------
# 1. Cloud PostgreSQL (Neon / Supabase / AWS RDS / DigitalOcean)
# Use pooled connection string with SSL required
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[DB_PASSWORD]@[DB_HOST]:5432/agri_commerce?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. Production JWT Secrets (Generate with `openssl rand -hex 64`)
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_secure_random_64_character_hex_key_for_production"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="replace_with_another_secure_random_64_character_hex_key"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Idempotency Cache Window
IDEMPOTENCY_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# 3. Cloud Redis (Upstash / Redis Cloud / AWS ElastiCache / Dragonfly)
# Required for distributed stock locking, BullMQ workers, OTP TTLs
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379"
REDIS_HOST="[REDIS_HOST]"
REDIS_PORT=6379
REDIS_PASSWORD="[REDIS_PASSWORD]"

# ------------------------------------------------------------------------------
# 4. Razorpay Live Payment Gateway
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_[YOUR_RAZORPAY_KEY_ID]"
RAZORPAY_KEY_SECRET="[YOUR_RAZORPAY_KEY_SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR_RAZORPAY_WEBHOOK_SECRET]"

# ------------------------------------------------------------------------------
# 5. Cloudinary (Public Product Media & Catalog Images Only)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="[YOUR_CLOUDINARY_CLOUD_NAME]"
CLOUDINARY_API_KEY="[YOUR_CLOUDINARY_API_KEY]"
CLOUDINARY_API_SECRET="[YOUR_CLOUDINARY_API_SECRET]"

# ------------------------------------------------------------------------------
# 6. Local Secure KYC Document Storage (NO AWS S3)
# Private mounted disk volume on server accessible only via Super Admin API
# ------------------------------------------------------------------------------
KYC_UPLOAD_DIR="/var/data/agri-uploads/kyc-docs"

# ------------------------------------------------------------------------------
# 7. SMS / WhatsApp Gateway Integration (Fast2SMS / Twilio / Gupshup)
# ------------------------------------------------------------------------------
SMS_PROVIDER="FAST2SMS" # Options: FAST2SMS, TWILIO
SMS_GATEWAY_API_KEY="[YOUR_SMS_GATEWAY_API_KEY]"
TWILIO_ACCOUNT_SID="[YOUR_TWILIO_ACCOUNT_SID]"
TWILIO_AUTH_TOKEN="[YOUR_TWILIO_AUTH_TOKEN]"
TWILIO_PHONE_NUMBER="[YOUR_TWILIO_PHONE_NUMBER]"

# ------------------------------------------------------------------------------
# 8. Initial Super Admin Seed Credentials (Used by prisma/seed.ts)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@kisanhit.com"
ADMIN_PHONE="9876543210"
ADMIN_PASSWORD="[SET_SECURE_STRONG_ADMIN_PASSWORD_MIN_8_CHARS]"

