# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/agri_commerce?schema=public"

# JWT Authentication
JWT_SECRET=supersecret_agri_jwt_key_default_change_in_prod
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=supersecret_agri_refresh_token_key_change_in_prod
REFRESH_TOKEN_EXPIRES_IN=7d

# Idempotency Configuration
IDEMPOTENCY_EXPIRY_HOURS=24

# Redis Configuration (ioredis + BullMQ)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=""

# Razorpay Payments & Webhooks
RAZORPAY_KEY_ID="rzp_test_mockKeyId123456"
RAZORPAY_KEY_SECRET="rzp_test_mockSecretKey123456"
RAZORPAY_WEBHOOK_SECRET="rzp_mock_webhook_secret_789"

# Cloudinary (Catalog Product Media Only)
CLOUDINARY_CLOUD_NAME="agri_mock_cloud"
CLOUDINARY_API_KEY="mock_cloudinary_key"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# Local Secure Dealer KYC Document Storage (NO AWS S3)
KYC_UPLOAD_DIR="./uploads/kyc-docs"
